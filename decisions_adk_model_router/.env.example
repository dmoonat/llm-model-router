# Google AI Studio / Gemini Developer API Key (required for Gemini Decisions API `gemini-decision-1` on `v1beta`)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Vertex AI via Google Cloud Application Default Credentials (ADC) for ADK Agents
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=dmoonat-experiment
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# Target Models for Decisions API Router
DECISION_MODEL=gemini-decision-1
SIMPLE_MODEL=gemini-3.1-flash-lite
COMPLEX_MODEL=gemini-3.1-pro-preview
